# Ejemplo sin credenciales reales. La configuración privada va en .env.
DATABASE_ENGINE=postgresql
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=arena_dev
PGUSER=arena_dev
PGPASSWORD=
PGSSLMODE=prefer
STORE_LATITUDE=-34.49823192111888
STORE_LONGITUDE=-58.67063072883498


# Checkout Pro vía Orders API. No pegar secretos en el chat ni activar sin pruebas.
MP_ENABLED=false
MP_ENVIRONMENT=test
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SELLER_ID=
MP_APPLICATION_ID=
MP_PUBLIC_BASE_URL=
# Al usar un túnel, agregar su host exacto (sin https) y su origen HTTPS.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Clave privada de Django. Generar una diferente para cada entorno.
DJANGO_SECRET_KEY=
